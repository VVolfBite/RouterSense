# Cluster identity
export ROUTERSENSE_NODE0=10.0.0.10
export ROUTERSENSE_NODE1=10.0.0.11
export ROUTERSENSE_SSH_USER=root
export ROUTERSENSE_REMOTE_ROOT=/root/routersense-deploy

# Shared model/corpus/capture locations visible on both nodes
export ROUTERSENSE_OLMOE_PATH=/shared/models/OLMoE-1B-7B-0924-Instruct
export ROUTERSENSE_CORPUS_PATH=/shared/routersense/corpus.jsonl
export ROUTERSENSE_CAPTURE_PATH=/shared/routersense/capture
export ROUTERSENSE_FATE_HINT_PATH=/shared/routersense/fate_hints.jsonl

# Formal-runtime commands from the latest full RS repository.
# Keep {output_dir}, {node_rank}, {nnodes}, {nproc_per_node}, {master_addr},
# {master_port}, {python}, {experiment}, and {deployment} literally present;
# the deploy driver substitutes them per host.
#
# Each command must fail non-zero when its gate fails. Files written under
# outputs/, RS/outputs/, or results/ are automatically copied into the stage
# evidence directory before the remote deploy tree is cleaned.
export ROUTERSENSE_FORMAL_CPU_COMMAND='{python} -m pytest -q RS/tests -m "not gpu and not nccl and not slow and not legacy"'
export ROUTERSENSE_GLOO_COMMAND='REPLACE_WITH_FORMAL_GLOO_COMMAND'
export ROUTERSENSE_NCCL_CORRECTNESS_COMMAND='REPLACE_WITH_FORMAL_NCCL_CORRECTNESS_COMMAND'
export ROUTERSENSE_RUNTIME_MATRIX_COMMAND='REPLACE_WITH_FORMAL_RUNTIME_MATRIX_COMMAND'
export ROUTERSENSE_FUTURE_FATE_COMMAND='REPLACE_WITH_FORMAL_FUTURE_FATE_COMMAND'
