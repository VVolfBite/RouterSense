{
  "formal_estimator": "rs.planning.estimation.CommonCorePlanEstimator",
  "decision_inputs": [
    "WindowPlan flows",
    "PlanningRequest semantic digest",
    "PlanningCostModel row_transfer_cost",
    "PlanningCostModel launch_cost",
    "PlanningCostModel full_duplex",
    "PlanningCostModel max_outgoing_per_rank_per_wave",
    "PlanningCostModel max_incoming_per_rank_per_wave",
    "PlanningCostModel expert_compute_delay"
  ],
  "explicitly_ignored_for_selection": [
    "plan.metadata.legacy_makespan",
    "wave.estimated_duration",
    "planner self-reported legacy duration"
  ],
  "validated_by_tests": [
    "legacy metadata independence",
    "legacy wave duration independence",
    "request digest mismatch invalidation",
    "negative row invalidation",
    "same-wave port conflict invalidation"
  ]
}
